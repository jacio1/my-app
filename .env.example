# Локальный режим работает без переменных. Для синхронизации:
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Публичный HTTPS-адрес после публикации; локально http://localhost:1001.
APP_URL=http://localhost:1001

# Только на сервере, НЕ NEXT_PUBLIC. JSON сервисного аккаунта в одну строку.
# Нужен для MCP/OAuth/API; обычный вход и синхронизация работают без него.
FIREBASE_SERVICE_ACCOUNT_KEY=

# Дополнительные точные HTTPS origins OAuth-клиентов через запятую.
# ChatGPT и loopback localhost/127.0.0.1 разрешены по умолчанию.
OAUTH_ALLOWED_REDIRECT_ORIGINS=

# Только для локального тестирования с Firebase Emulator Suite:
# NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
